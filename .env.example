# Copy to .env and fill in. Never commit the filled-in file.
# The server does not read this file itself: set these in the shell that starts it.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
TILES_DIR=data/tiles

# Lab chatbot for the Recipe Maker (see docs/CHATBOT_INTEGRATION.md). All three
# or none; without them the Recipe Maker uses its labelled offline demo.
# CHATBOT_URL=http://<service-host>:8101
# CHATBOT_FAMILY=doc
# CHATBOT_ID=<an id that exists on the service>
