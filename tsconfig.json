{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@core/*": ["packages/core/src/*"] }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "e2e/**/*.ts", "*.config.ts"]
}
